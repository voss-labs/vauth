# Copy to .env (and .dev.vars for `wrangler dev`). Never commit either.

# Neon Postgres. voss-auth stores identity ONLY — users, sessions, credentials,
# OAuth clients, signing keys. No student records, no marks, no roll numbers.
DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require

# The OIDC issuer. Must match the deployed origin, or discovery breaks.
BETTER_AUTH_URL=http://localhost:5173

# openssl rand -base64 32
# Leaking this lets anyone forge a session on the identity provider.
BETTER_AUTH_SECRET=

# Resend. Use a send-only key.
RESEND_API_KEY=
EMAIL_FROM=VOSS Labs <accounts@vosslabs.org>
