{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vauth",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-07-14",
  // nodejs_compat is required: better-auth reaches for node:crypto and
  // AsyncLocalStorage. Without it the build fails outright.
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "assets": {
    // Without this the asset layer answers first and returns 405 to every
    // non-GET request whose path collides with an asset route — which silently
    // breaks every form POST in the app, including the account page. Hashed
    // build assets are excluded so they stay free and never invoke the Worker.
    "run_worker_first": ["/*", "!/assets/*"]
  },
  // Durable rate-limit store. Better Auth's default limiter is in-memory and
  // therefore per-isolate on Workers — an attacker rotating isolates dilutes it.
  // Backing it with KV makes the OTP-spam limits survive across isolates. See the
  // rateLimit.customStorage wiring in app/lib/auth.server.ts.
  "kv_namespaces": [
    { "binding": "RATE_LIMIT_KV", "id": "f1dae3c884a445fd9980f702da22abe7" }
  ],
  "vars": {
    // The OIDC issuer is derived from this, so it MUST equal the origin the
    // worker is actually served from. Get it wrong and discovery advertises
    // endpoints that 404, and every relying party silently fails to find us.
    // Local dev overrides this via .dev.vars, which takes precedence.
    "BETTER_AUTH_URL": "https://accounts.vosslabs.org",

    // Not a secret. Deliberately not no-reply: passwordless makes email the only
    // door in, so a student who never gets their code will hit Reply, and that
    // has to reach a human.
    "EMAIL_FROM": "VOSS Labs <accounts@vosslabs.org>"
  },
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "routes": [
    {
      "pattern": "accounts.vosslabs.org",
      "custom_domain": true
    }
  ]
}
